# ---- Public site -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://peachpad.fun
NEXT_PUBLIC_X_URL=https://x.com/Peachpad_

# ---- Chain -----------------------------------------------------------------
# Robinhood Chain (chain id 4663). Re-verify against
# https://docs.robinhood.com/chain before pointing real funds at it.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://explorer.mainnet.chain.robinhood.com

# ---- Contracts -------------------------------------------------------------
# The Peach Pad router (contracts/PeachRouter.sol). `npm run deploy:robinhood`
# in contracts/ prints this. The launches list, the token pages and the
# launch form all read from it; with it unset the list is empty and the
# Launch button stays disabled.
NEXT_PUBLIC_PEACHPAD_ROUTER=
# The pad's own token. The Token section shows "TBA" until it is set.
NEXT_PUBLIC_PEACH_TOKEN=
# Fallback launch fee shown before the router answers, in ETH.
NEXT_PUBLIC_LAUNCH_FEE_ETH=0.0005

# ---- Server only -----------------------------------------------------------
# Where POST /api/upload forwards token images (multipart, returns { uri }).
PONS_IPFS_UPLOAD_URL=
