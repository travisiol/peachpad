# ---- Public site -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://peachpad.fun
NEXT_PUBLIC_X_URL=https://x.com/Peachpad_

# ---- Chain -----------------------------------------------------------------
# Robinhood Chain. Re-verify against https://docs.robinhood.com/chain before
# pointing real funds at it.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://explorer.mainnet.chain.robinhood.com

# ---- Contracts (all unset = nothing is live) --------------------------------
# The Peach Pad middleware router: launches onto Pons V2 and deploys the
# 90/10 fee splitter per token. While unset the Launch and Collect buttons
# stay disabled and say so.
NEXT_PUBLIC_PEACHPAD_ROUTER=
# The pad's own token. While unset the Token section shows "not deployed"
# instead of a contract address — no placeholder address is ever rendered.
NEXT_PUBLIC_PEACH_TOKEN=
# Launch fee charged by the router, in ETH (display only; the router is the
# source of truth once deployed).
NEXT_PUBLIC_LAUNCH_FEE_ETH=0.0005

# ---- Data (server only) ------------------------------------------------------
# Indexer that lists tokens launched through the router. Response shape:
# { ok, launches: [...] } — see src/lib/pons.ts. While unset /api/launches
# serves the bundled sample set and flags it as `source: "sample"`.
PEACHPAD_INDEXER_URL=
# Pons V2 market API base. /api/pons/v2/<token>/{summary,trades,chart} proxy
# to `${PONS_API_BASE}/<token>/{summary,trades,chart}`. While unset the
# proxies answer only for the sample tokens.
PONS_API_BASE=
